  "gourmands": [
    {
      "pool": "normal",
      "number": 1,
      "look": "少年警员",
      "likes": "<面粉>",
      "requests": [
        {
          "text": "来些面食，多放盐，我口味重。",
          "when": "[咸]&<面粉>"
        },
        {
          "text": "还有没有不带鳞腥味的面食？",
          "when": "非[鲜]&<面粉>"
        },
        {
          "text": "我想想，炒个菜吧，越辣越好。",
          "when": "菜肴&[辣]"
        },
        {
          "text": "咸的辣的都行，随便来些好吃的。",
          "when": "[咸]或[辣]"
        },
        {
          "text": "这两天牙疼，别上酸的。",
          "when": "非[酸]"
        },
        {
          "text": "不太甜的点心吧，在刷体脂。",
          "when": "甜品&非[甜]"
        }
      ]
    },
    {
      "pool": "normal",
      "number": 2,
      "look": "成年女工程师",
      "likes": "<(优质)鳞肉>",
      "requests": [
        {
          "text": "果然鳞还是要吃新鲜的……",
          "when": "[鲜]&<(优质)鳞肉>"
        },
        {
          "text": "有没有“鳞游水中”？就是鳞汤啦。",
          "when": "汤羹&<优质鳞肉>"
        },
        {
          "text": "想吃水产……会不会很麻烦？",
          "when": "[水产]"
        },
        {
          "text": "锅气十足的菜，啊，千万不要辣。",
          "when": "菜肴&非[辣]"
        },
        {
          "text": "酸酸甜甜，果汁之类的有没有？",
          "when": "[果香]"
        },
        {
          "text": "再来点喝的，但不要茶，会失眠。",
          "when": "非[茶香]"
        }
      ]
    },
    {
      "pool": "normal",
      "number": 3,
      "look": "老教师",
      "likes": "汤羹或[滋补]",
      "requests": [
        {
          "text": "来份汤，要清淡。",
          "when": "汤羹&非[辣]&非[咸]"
        },
        {
          "text": "素菜一道。",
          "when": "菜肴&[素食]"
        },
        {
          "text": "滋补身心的良膳，来一道。",
          "when": "[滋补]"
        },
        {
          "text": "清爽无油的汤羹，有吗？",
          "when": "汤羹&非<菜籽油>"
        },
        {
          "text": "香茗一杯。",
          "when": "[茶香]"
        },
        {
          "text": "来杯喝的，谨记，我滴酒不沾。",
          "when": "非[酒香]"
        }
      ]
    },
    {
      "pool": "normal",
      "number": 4,
      "look": "少女警员",
      "likes": "甜品或[美观]",
