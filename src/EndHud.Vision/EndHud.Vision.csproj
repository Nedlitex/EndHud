<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows SDK projections give us Windows.Graphics.Capture and Windows.Media.Ocr. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EndHud.Vision</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndHud.Vision.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Built-in operator library, compiled into this assembly: roster, avatar and skill icons
      (from endfield.wiki.gg) and portraits learned from gameplay. Refresh with
      `endhud-cli fetch-operators src/EndHud.Vision/Assets/operators`.
      Game art: personal use only.
    -->
    <EmbeddedResource Include="Assets\operators\**" LogicalName="operators/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
