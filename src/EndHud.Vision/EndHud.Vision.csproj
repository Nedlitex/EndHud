<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows SDK projections give us Windows.Graphics.Capture and Windows.Media.Ocr. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EndHud.Vision</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndHud.Vision.Tests" />
    <!-- The developer CLI's trace-skills names the squad on a recording's own clock (SquadIdentifier's clock parameter). -->
    <InternalsVisibleTo Include="endhud-cli" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs the character recognition model (on the CPU). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The character recognition model (CCIP, see tools/ccip-model), compiled in so recognition
      works out of the box. It isn't game art: the roster, avatars and skill icons are never
      shipped; they're downloaded from the wiki on first start (OperatorReference).
    -->
    <EmbeddedResource Include="Assets\ccip\ccip-features-int8.onnx" LogicalName="ccip-features-int8.onnx" />
    <EmbeddedResource Include="Assets\ccip\ccip-metrics.onnx" LogicalName="ccip-metrics.onnx" />
    <!-- The operator library (roster, avatars, skill icons, statuses) EndHud starts with: see OperatorPackage. -->
    <EmbeddedResource Include="..\..\operators\operator-library.zip" LogicalName="operator-library.zip" />
    <!--
      Each operator's in-game squad portrait as the model describes it (numbers, not images),
      built from the test fixtures' squad screenshots; see PortraitReferences.
    -->
    <EmbeddedResource Include="Assets\operator-portraits.json" LogicalName="operator-portraits.json" />
  </ItemGroup>

</Project>
