<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows SDK projections give us Windows.Graphics.Capture and Windows.Media.Ocr. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EndHud.Vision</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndHud.Vision.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The only built-in operator data: where a wiki avatar sits inside a squad portrait (a few
      numbers measured on gameplay). The roster, avatars and skill icons are game art and are
      never shipped: they're downloaded from the wiki on first start (OperatorReference).
    -->
    <EmbeddedResource Include="Assets\calibration.json" LogicalName="calibration.json" />
  </ItemGroup>

</Project>
