<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The tray icon's design (a gold "E" on a dark tile), for the exe, taskbar and installer. -->
    <ApplicationIcon>EndHud.ico</ApplicationIcon>
    <AssemblyName>EndHud</AssemblyName>
    <!-- Release builds get the version from the tag (release.yml: -p:Version=1.2.0); 0.0.0 marks a development build. -->
    <Version>0.0.0</Version>
    <RootNamespace>EndHud</RootNamespace>
    <!-- WinForms analyzer wants DPI set via its API; this is a WPF app, where the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Program.Main restricts where Windows looks for DLLs before anything else loads (see Program.cs). -->
    <StartupObject>EndHud.Program</StartupObject>
    <!-- No DOTNET_STARTUP_HOOKS: nothing outside EndHud runs code inside it at start. -->
    <StartupHookSupport>false</StartupHookSupport>
    <!--
      The packages a release publish restores (release.yml: -r win-x64, single file) are the ones every build
      restores, so one packages.lock.json holds them and CI can restore it in locked mode.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Layout and window arithmetic is tested directly. -->
    <InternalsVisibleTo Include="EndHud.Tests" />
    <!-- Renders the README animations with the real banner code. -->
    <InternalsVisibleTo Include="EndHud.ReadmeMedia" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms/Drawing names clash with WPF ones (Application, Button, Color…); import them explicitly where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EndHud.Vision\EndHud.Vision.csproj" />
  </ItemGroup>

</Project>
