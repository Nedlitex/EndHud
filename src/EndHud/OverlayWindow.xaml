<Window x:Class="EndHud.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EndHud Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Left="0" Top="0" Width="800" Height="600">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFE6C229" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEFFFFFF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
    <Grid x:Name="HudRoot">
    <!-- Debug panel (menu checkbox, tray, Ctrl+Shift+D): what EndHud reads from the screen, and alignment marks. -->
    <Grid x:Name="DebugRoot" Visibility="Collapsed">
        <!-- Corner brackets: show at a glance that the overlay is aligned to the game's client area. -->
        <Path Data="M0,24 L0,0 L24,0" Stroke="{StaticResource Accent}" StrokeThickness="2"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" />
        <Path Data="M0,0 L24,0 L24,24" Stroke="{StaticResource Accent}" StrokeThickness="2"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" />
        <Path Data="M0,0 L0,24 L24,24" Stroke="{StaticResource Accent}" StrokeThickness="2"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" />
        <Path Data="M0,24 L24,24 L24,0" Stroke="{StaticResource Accent}" StrokeThickness="2"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" />

        <!-- Status panel. Left-centre: the free strip between the game's minimap/quest text and the squad panel. -->
        <!-- Draggable while the menu is open (config DebugOffsetX/Y). -->
        <Border x:Name="StatusPanel" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="36,0,0,0"
                Padding="14,10" CornerRadius="4" MinWidth="240"
                Background="#B0101418" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0"
                SizeChanged="DraggablePanel_SizeChanged"
                PreviewMouseLeftButtonDown="DraggablePanel_MouseDown" PreviewMouseMove="DraggablePanel_MouseMove"
                PreviewMouseLeftButtonUp="DraggablePanel_MouseUp">
            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
            <StackPanel>
                <TextBlock x:Name="DebugPanelDragLabel" Visibility="Collapsed" Text="{DynamicResource DebugPanel.Drag}"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                <TextBlock Text="{DynamicResource Hud.Title}" Foreground="{StaticResource Accent}" FontWeight="Bold"
                           FontSize="15" Margin="0,0,0,6" />
                <TextBlock x:Name="StatusText" />
                <TextBlock x:Name="SizeText" Foreground="#AAFFFFFF" />
                <TextBlock x:Name="ClockText" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />

                <StackPanel x:Name="PartySection" Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource Party.Header}" Foreground="{StaticResource Accent}"
                               FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock x:Name="PartyText" LineHeight="18" TextWrapping="Wrap" MaxWidth="360" />
                    <TextBlock x:Name="LibraryText" Visibility="Collapsed" Foreground="#AAFFFFFF" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="300" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,36"
                   Foreground="#99FFFFFF" FontSize="11" Text="{DynamicResource Hud.Hint}" />
    </Grid>

    <!-- Combo-ready hints, styled after the game's own combo banner. Placed at a fraction of the game
         window (config ComboHintX/Y); draggable while the menu is open. -->
    <Canvas x:Name="HintCanvas" SizeChanged="HintCanvas_SizeChanged">
        <Border x:Name="ComboHintFrame" BorderThickness="2" Padding="6" CornerRadius="4" Background="Transparent"
                MouseLeftButtonDown="ComboHint_MouseDown" MouseMove="ComboHint_MouseMove"
                MouseLeftButtonUp="ComboHint_MouseUp">
            <StackPanel>
                <TextBlock x:Name="ComboHintDragLabel" Visibility="Collapsed" Text="{DynamicResource ComboHint.Drag}"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                <StackPanel x:Name="ComboHintStack" />
            </StackPanel>
        </Border>
        <!-- The rotation strip (排轴), centred on config RotationCenterX, top at RotationY. -->
        <Border x:Name="RotationFrame" BorderThickness="2" Padding="6" CornerRadius="4" Background="Transparent"
                Visibility="Collapsed" SizeChanged="RotationFrame_SizeChanged"
                MouseLeftButtonDown="Rotation_MouseDown" MouseMove="Rotation_MouseMove"
                MouseLeftButtonUp="Rotation_MouseUp">
            <StackPanel>
                <TextBlock x:Name="RotationDragLabel" Visibility="Collapsed" Text="{DynamicResource Rotation.Drag}"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                <ContentControl x:Name="RotationContent" />
            </StackPanel>
        </Border>
        <!-- The kitchens' circles (each kitchen's next dish, one column per kitchen), above the held-dishes tray; centre and
             bottom at config InnCircleX/InnCircleY (InnKitchenCircleLayout), draggable while the menu is open. The drag
             label sits above the row without moving it. -->
        <Border x:Name="InnCircleFrame" BorderThickness="2" Padding="6" CornerRadius="4" Background="Transparent"
                MouseLeftButtonDown="InnCircle_MouseDown" MouseMove="InnCircle_MouseMove"
                MouseLeftButtonUp="InnCircle_MouseUp">
            <Grid>
                <TextBlock x:Name="InnCircleDragLabel" Visibility="Collapsed" Text="{DynamicResource Inn.Circle.Drag}"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-26,0,0" />
                <Grid x:Name="InnCircleSlots" />
            </Grid>
        </Border>
        <!-- The same circles while the dispatch panel is open, in a row just below it (InnKitchenCircleLayout.BelowPanel):
             the panel covers the tray and the row above it. Placed by the game's layout, not dragged. -->
        <Border x:Name="InnCirclePanelFrame" BorderThickness="2" Padding="6" CornerRadius="4" Background="Transparent"
                Visibility="Hidden" IsHitTestVisible="False">
            <Grid x:Name="InnCirclePanelSlots" />
        </Border>
        <!-- The inn session's banners (the last call, Full Blaze), styled like the
             combo-ready hints; top-left corner at config InnCallX/InnCallY, draggable while the menu is open. -->
        <Border x:Name="InnCallFrame" BorderThickness="2" Padding="6" CornerRadius="4" Background="Transparent"
                MouseLeftButtonDown="InnCall_MouseDown" MouseMove="InnCall_MouseMove"
                MouseLeftButtonUp="InnCall_MouseUp">
            <StackPanel>
                <TextBlock x:Name="InnCallDragLabel" Visibility="Collapsed" Text="{DynamicResource Inn.Call.Drag}"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                <StackPanel x:Name="InnCallStack" />
            </StackPanel>
        </Border>
        <!-- The gourmands' tiles (one per gourmand: each request's item and its picture), each at its table's fixed spot
             (InnGourmandLayout: tables 1-3 down the left edge, 4-6 down the right), panel open or closed. Never hit-tested,
             never dragged. -->
        <Canvas x:Name="InnGourmandTiles" IsHitTestVisible="False" />
        <!-- The gauges, centred on config GaugesCenterX, standing on GaugesBottomY. -->
        <Border x:Name="GaugeFrame" BorderThickness="2" Padding="6" CornerRadius="4" Background="Transparent"
                Visibility="Collapsed" SizeChanged="GaugeFrame_SizeChanged"
                MouseLeftButtonDown="Gauges_MouseDown" MouseMove="Gauges_MouseMove"
                MouseLeftButtonUp="Gauges_MouseUp">
            <StackPanel>
                <TextBlock x:Name="GaugeDragLabel" Visibility="Collapsed" Text="{DynamicResource Gauge.Drag}"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                <ContentControl x:Name="GaugeContent" />
            </StackPanel>
        </Border>
    </Canvas>
    </Grid>

    <!-- Menu: while open, the overlay accepts mouse/keyboard input; closed, it is click-through again.
         Dragged by any part that isn't a control (config MenuOffsetX/Y). -->
    <Border x:Name="MenuPanel" Visibility="Collapsed"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Margin="0,16"
            Padding="0,16" CornerRadius="6"
            Background="#E6101418" BorderBrush="{StaticResource Accent}" BorderThickness="0,3,0,0"
            SizeChanged="DraggablePanel_SizeChanged"
            PreviewMouseLeftButtonDown="DraggablePanel_MouseDown" PreviewMouseMove="DraggablePanel_MouseMove"
            PreviewMouseLeftButtonUp="DraggablePanel_MouseUp">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Border.Resources>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#EEFFFFFF" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                <Setter Property="Margin" Value="0,4" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>
            <!-- One card per feature: its name and on/off switch on top, its settings below. -->
            <Style x:Key="FeatureCard" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,8,12,10" />
                <Setter Property="Margin" Value="0,14,0,0" />
            </Style>
            <Style x:Key="FeatureTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="FeatureNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="#FFFFB86B" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,4" />
            </Style>
        </Border.Resources>
        <!-- Scrolls when the game window is too short for the whole menu. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0">
        <StackPanel>
            <TextBlock Text="{DynamicResource Menu.Title}" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="16" />
            <TextBlock x:Name="VersionText" Foreground="#CCFFFFFF" FontSize="11" />
            <TextBlock Text="{DynamicResource Menu.DragHint}" Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Text="{DynamicResource Menu.Hotkeys}" Style="{StaticResource SectionHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ctrl+Shift+M / Ctrl+F9" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Menu.Key.Menu}" />
                <TextBlock Grid.Row="1" Text="Ctrl+Shift+H / Ctrl+F10" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Menu.Key.Toggle}" />
                <TextBlock Grid.Row="2" Text="Ctrl+Shift+Q" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Menu.Key.Quit}" />
                <TextBlock Grid.Row="3" Text="Ctrl+Shift+D / Ctrl+F11" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Menu.Key.Debug}" />
                <TextBlock Grid.Row="4" Text="Esc" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Menu.Key.Esc}" />
            </Grid>

            <!-- Real settings, saved to config.json. -->
            <TextBlock Text="{DynamicResource Menu.Settings}" Style="{StaticResource SectionHeader}" />
            <CheckBox x:Name="AutoShowCheckBox" Click="AutoShowCheckBox_Click">
                <TextBlock Text="{DynamicResource Menu.AutoShow}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{DynamicResource Menu.AutoShow.Hint}" Foreground="#99FFFFFF" FontSize="11"
                       Margin="20,0,0,4" TextWrapping="Wrap" />
            <CheckBox x:Name="PartyOcrCheckBox" Click="PartyOcrCheckBox_Click">
                <TextBlock Text="{DynamicResource Menu.PartyOcr}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{DynamicResource Menu.PartyOcr.Hint}" Foreground="#99FFFFFF" FontSize="11"
                       Margin="20,0,0,4" TextWrapping="Wrap" />
            <CheckBox x:Name="AutoStartCheckBox" Click="AutoStartCheckBox_Click">
                <TextBlock Text="{DynamicResource Menu.AutoStart}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{DynamicResource Menu.AutoStart.Hint}" Foreground="#99FFFFFF" FontSize="11"
                       Margin="20,0,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="AutoStartError" Foreground="{StaticResource Accent}" FontSize="11" Margin="20,0,0,4"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <CheckBox x:Name="DebugPanelCheckBox" Click="DebugPanelCheckBox_Click">
                <TextBlock Text="{DynamicResource Menu.DebugPanel}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="CheckForUpdatesCheckBox" Click="CheckForUpdatesCheckBox_Click">
                <TextBlock Text="{DynamicResource Menu.CheckForUpdates}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="AutoInstallUpdatesCheckBox" Click="AutoInstallUpdatesCheckBox_Click" Margin="20,0,0,4">
                <TextBlock Text="{DynamicResource Menu.AutoInstallUpdates}" TextWrapping="Wrap" />
            </CheckBox>
            <!-- Diagnostics: a zip to send when something doesn't work (DiagnosticExport). -->
            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                <Button x:Name="ExportDiagnosticsButton" DockPanel.Dock="Left" Padding="10,2"
                        Content="{DynamicResource Menu.ExportDiagnostics}" Click="ExportDiagnosticsButton_Click" />
                <TextBlock x:Name="DiagnosticsStatus" Foreground="{StaticResource Accent}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{DynamicResource Menu.ExportDiagnostics.Hint}" Foreground="#99FFFFFF" FontSize="11"
                       Margin="0,2,0,4" TextWrapping="Wrap" />

            <!-- Feature: combo-ready hint. -->
            <Border Style="{StaticResource FeatureCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="ComboHintCheckBox" DockPanel.Dock="Right" Click="ComboHintSetting_Changed" Margin="0">
                            <TextBlock Text="{DynamicResource Menu.Feature.On}" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Menu.ComboHint}" Style="{StaticResource FeatureTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="ComboHintNeedsPartyOcr" Text="{DynamicResource Menu.Feature.NeedsPartyOcr}"
                               Style="{StaticResource FeatureNote}" Visibility="Collapsed" />
                    <TextBlock Text="{DynamicResource Menu.ComboHint.Hint}" Foreground="#99FFFFFF" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,4" />
                    <StackPanel x:Name="ComboHintSettings">
                        <StackPanel x:Name="ComboHintModes">
                            <StackPanel.Resources>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Foreground" Value="#EEFFFFFF" />
                                    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ComboHintWhenReady" GroupName="ComboHintMode" Click="ComboHintSetting_Changed">
                                    <TextBlock Text="{DynamicResource Menu.ComboHint.WhenReady}" />
                                </RadioButton>
                                <ComboBox x:Name="ComboHintSecondsPicker" Margin="8,0,0,0" Width="80"
                                          SelectionChanged="ComboHintSetting_Changed" />
                            </StackPanel>
                            <RadioButton x:Name="ComboHintWhileReady" GroupName="ComboHintMode" Click="ComboHintSetting_Changed">
                                <TextBlock Text="{DynamicResource Menu.ComboHint.WhileReady}" />
                            </RadioButton>
                            <!-- Shown a little before the combo is ready, counting down. -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{DynamicResource Menu.ComboHint.Lead}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ComboHintLeadPicker" Margin="8,0,0,0" Width="80"
                                          SelectionChanged="ComboHintSetting_Changed" />
                            </StackPanel>
                            <Button x:Name="ComboHintResetButton" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,0"
                                    Content="{DynamicResource Menu.ComboHint.ResetPosition}" Click="ComboHintResetButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Feature: rotation strip (排轴). -->
            <Border Style="{StaticResource FeatureCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="RotationCheckBox" DockPanel.Dock="Right" Click="RotationCheckBox_Click" Margin="0">
                            <TextBlock Text="{DynamicResource Menu.Feature.On}" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Menu.Rotation}" Style="{StaticResource FeatureTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="RotationNeedsPartyOcr" Text="{DynamicResource Menu.Feature.NeedsPartyOcr}"
                               Style="{StaticResource FeatureNote}" Visibility="Collapsed" />
                    <TextBlock Text="{DynamicResource Menu.Rotation.Hint}" Foreground="#99FFFFFF" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,4" />
                    <!-- Size: on top of following the game window. Applied while dragging. -->
                    <DockPanel x:Name="RotationSizeRow" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Menu.Gauges.Size}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="RotationSizeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="RotationSizeSlider" Minimum="0.5" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="RotationSizeSlider_ValueChanged" />
                    </DockPanel>
                    <DockPanel x:Name="RotationOpacityRow" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Menu.Rotation.Opacity}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="RotationOpacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="RotationOpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="RotationOpacitySlider_ValueChanged" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- Editing works with the strip off: rotations can be prepared before turning it on. -->
                        <Button x:Name="EditRotationsButton" Padding="10,2" Margin="0,0,6,0"
                                Content="{DynamicResource Menu.Rotation.Edit}" Click="EditRotationsButton_Click" />
                        <Button x:Name="RotationResetButton" Padding="10,2"
                                Content="{DynamicResource Menu.Rotation.ResetPosition}" Click="RotationResetButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Feature: gauges. -->
            <Border Style="{StaticResource FeatureCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="GaugesCheckBox" DockPanel.Dock="Right" Click="GaugesCheckBox_Click" Margin="0">
                            <TextBlock Text="{DynamicResource Menu.Feature.On}" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Menu.Gauges}" Style="{StaticResource FeatureTitle}" />
                    </DockPanel>
                    <TextBlock x:Name="GaugesNeedsPartyOcr" Text="{DynamicResource Menu.Feature.NeedsPartyOcr}"
                               Style="{StaticResource FeatureNote}" Visibility="Collapsed" />
                    <TextBlock Text="{DynamicResource Menu.Gauges.Hint}" Foreground="#99FFFFFF" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,4" />
                    <!-- Size: on top of following the game window. Applied while dragging. -->
                    <DockPanel x:Name="GaugesSizeRow" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Menu.Gauges.Size}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="GaugesSizeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="GaugesSizeSlider" Minimum="0.5" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="GaugesSizeSlider_ValueChanged" />
                    </DockPanel>
                    <Button x:Name="GaugesResetButton" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,0"
                            Content="{DynamicResource Menu.Gauges.ResetPosition}" Click="GaugesResetButton_Click" />
                </StackPanel>
            </Border>

            <!-- Feature: the inn helper. Works without the squad panel's reading. -->
            <Border Style="{StaticResource FeatureCard}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="InnCheckBox" DockPanel.Dock="Right" Click="InnCheckBox_Click" Margin="0">
                            <TextBlock Text="{DynamicResource Menu.Feature.On}" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Menu.Inn}" Style="{StaticResource FeatureTitle}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Menu.Inn.Hint}" Foreground="#99FFFFFF" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,4" />
                    <CheckBox x:Name="InnCallsCheckBox" Click="InnCallsCheckBox_Click" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Menu.Inn.Calls}" />
                    </CheckBox>
                    <CheckBox x:Name="InnSwapsCheckBox" Click="InnSwapsCheckBox_Click" Margin="0,4,0,0"
                              ToolTip="{DynamicResource Menu.Inn.Swaps.Hint}">
                        <TextBlock Text="{DynamicResource Menu.Inn.Swaps}" TextWrapping="Wrap" />
                    </CheckBox>
                    <DockPanel x:Name="InnSizeRow" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Menu.Gauges.Size}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="InnSizeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="InnSizeSlider" Minimum="0.5" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="InnSizeSlider_ValueChanged" />
                    </DockPanel>
                    <DockPanel x:Name="InnOpacityRow" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Menu.Rotation.Opacity}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="InnOpacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="InnOpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="InnOpacitySlider_ValueChanged" />
                    </DockPanel>
                    <Button x:Name="InnResetButton" HorizontalAlignment="Left" Padding="10,2" Margin="0,4,0,0"
                            Content="{DynamicResource Menu.Inn.ResetPosition}" Click="InnResetButton_Click" />
                </StackPanel>
            </Border>

            <!-- Operator recognition: pick the right operator per slot; EndHud learns from it. -->
            <TextBlock Text="{DynamicResource Menu.Operators}" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
            <TextBlock Text="{DynamicResource Menu.Operators.Hint}" Foreground="#99FFFFFF" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="OperatorPickersEmpty" TextWrapping="Wrap" Foreground="#CCFFFFFF" Margin="0,2" />
            <StackPanel x:Name="OperatorPickers" />
            <DockPanel Margin="0,6,0,0" LastChildFill="True">
                <Button x:Name="ForgetLearnedButton" DockPanel.Dock="Left" Padding="10,2"
                        Content="{DynamicResource Menu.Operators.Forget}" Click="ForgetLearnedButton_Click" />
                <TextBlock x:Name="OperatorsStatus" Foreground="{StaticResource Accent}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
            </DockPanel>

            <Button x:Name="CloseMenuButton" Content="{DynamicResource Menu.Close}" HorizontalAlignment="Right"
                    Margin="0,16,0,0" Padding="18,4" Click="CloseMenuButton_Click" />
        </StackPanel>
        </ScrollViewer>
    </Border>
    </Grid>
</Window>
