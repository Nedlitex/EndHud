<Window x:Class="EndHud.RotationEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Editor.Title}"
        Width="1200" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Which rotation -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource Editor.Rotation}" Style="{StaticResource Label}" />
            <ComboBox x:Name="RotationPicker" MinWidth="320" SelectionChanged="RotationPicker_SelectionChanged" />
            <Button x:Name="NewButton" Content="{DynamicResource Editor.New}" Click="NewButton_Click" />
            <Button x:Name="CopyButton" Content="{DynamicResource Editor.Copy}" Click="CopyButton_Click" />
            <Button x:Name="DeleteButton" Content="{DynamicResource Editor.Delete}" Click="DeleteButton_Click" />
        </StackPanel>

        <!-- Name and squad -->
        <StackPanel Grid.Row="1" x:Name="Header" Margin="0,0,0,8">
            <TextBlock x:Name="EmptyText" Text="{DynamicResource Editor.Empty}" Foreground="#666" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBlock x:Name="PublishedNote" Text="{DynamicResource Editor.PublishedNote}" Foreground="#1F5FAF"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
            <TextBlock x:Name="UnreadableText" Foreground="#B04030" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Editor.Name}" Style="{StaticResource Label}" />
                <TextBox x:Name="NameBox" Width="220" Margin="0,0,16,0" TextChanged="NameBox_TextChanged" />
                <TextBlock Text="{DynamicResource Editor.Squad}" Style="{StaticResource Label}" />
                <ComboBox x:Name="Squad0" MinWidth="120" SelectionChanged="Squad_SelectionChanged" />
                <ComboBox x:Name="Squad1" MinWidth="120" SelectionChanged="Squad_SelectionChanged" />
                <ComboBox x:Name="Squad2" MinWidth="120" SelectionChanged="Squad_SelectionChanged" />
                <ComboBox x:Name="Squad3" MinWidth="120" SelectionChanged="Squad_SelectionChanged" />
                <Button x:Name="UseCurrentSquadButton" Content="{DynamicResource Editor.UseCurrentSquad}" Click="UseCurrentSquadButton_Click" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The phases, in order; one with an entry condition is switched to when it holds -->
            <!-- The header wraps: as one line it is wider than the column, and WPF then lays the whole box
                 out at that width and clips its right edge (condition rows and hints were cut off). -->
            <GroupBox Grid.Column="0">
                <GroupBox.Header>
                    <TextBlock Text="{DynamicResource Editor.Phases}" TextWrapping="Wrap" MaxWidth="370" />
                </GroupBox.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ListBox x:Name="PhaseList" Height="100" SelectionChanged="PhaseList_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="↑" Click="PhaseUp_Click" ToolTip="{DynamicResource Editor.MoveUp}" />
                            <Button Content="↓" Click="PhaseDown_Click" ToolTip="{DynamicResource Editor.MoveDown}" />
                            <Button x:Name="NewPhaseButton" Content="{DynamicResource Editor.NewPhase}" Click="NewPhase_Click" />
                            <Button x:Name="CopyPhaseButton" Content="{DynamicResource Editor.CopyPhase}" Click="CopyPhase_Click" ToolTip="{DynamicResource Editor.CopyPhaseHint}" />
                            <Button Content="{DynamicResource Editor.DeletePhase}" Click="DeletePhase_Click" />
                        </StackPanel>
                        <CheckBox x:Name="LastMatchWinsBox" Content="{DynamicResource Editor.LastMatchWins}" Margin="0,6,0,0"
                                  ToolTip="{DynamicResource Editor.LastMatchWinsHint}" Checked="LastMatchWins_Changed" Unchecked="LastMatchWins_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{DynamicResource Editor.PhaseName}" Style="{StaticResource Label}" />
                            <TextBox x:Name="PhaseNameBox" Width="200" TextChanged="PhaseNameBox_TextChanged" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Editor.Gate}" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock Text="{DynamicResource Editor.GateHint}" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <StackPanel x:Name="GateRows" />
                        <Button x:Name="AddGateButton" Content="{DynamicResource Editor.AddCondition}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Click="AddGateCondition_Click" />

                        <!-- The phase's priority: a whole number, then rules "if this holds, the priority is that".
                             The hints and the refusal are set in code (Loc), so they show outside the app too. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource Editor.Priority}" FontWeight="SemiBold" Style="{StaticResource Label}" />
                            <TextBox x:Name="PriorityBox" Width="70" VerticalAlignment="Center" TextChanged="PriorityBox_TextChanged" />
                        </StackPanel>
                        <TextBlock x:Name="PriorityError" Foreground="#B04030" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="PriorityNeedsGate" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="PriorityHint" Foreground="#888" TextWrapping="Wrap" Margin="0,2,0,6" />
                        <TextBlock Text="{DynamicResource Editor.PriorityRules}" FontWeight="SemiBold" Margin="0,6,0,2" />
                        <TextBlock x:Name="PriorityRulesHint" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <StackPanel x:Name="PriorityRuleRows" />
                        <Button x:Name="AddPriorityRuleButton" Content="{DynamicResource Editor.AddPriorityRule}" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Click="AddPriorityRule_Click" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- The selected phase's steps -->
            <GroupBox Grid.Column="2" x:Name="StepsGroup">
                <Grid>
                    <!-- Shared by ratio, not a fixed 300 for the list: at the window's smallest width the step
                         details (operator, action, the basic-attack hint, "with the previous step") were cut off on the right. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="200" MaxWidth="300" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button x:Name="AddStepButton" Content="{DynamicResource Editor.AddStep}" Click="AddStep_Click" />
                            <Button Content="↑" Click="StepUp_Click" ToolTip="{DynamicResource Editor.MoveUp}" />
                            <Button Content="↓" Click="StepDown_Click" ToolTip="{DynamicResource Editor.MoveDown}" />
                            <Button Content="{DynamicResource Editor.DeleteStep}" Click="DeleteStep_Click" />
                        </WrapPanel>
                        <ListBox x:Name="StepList" SelectionChanged="StepList_SelectionChanged" />
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StepDetails">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource Editor.Operator}" Style="{StaticResource Label}" Width="70" />
                                <ComboBox x:Name="StepOperator" MinWidth="140" SelectionChanged="StepField_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource Editor.Action}" Style="{StaticResource Label}" Width="70" />
                                <ComboBox x:Name="StepActionPicker" MinWidth="140" SelectionChanged="StepField_Changed" />
                            </StackPanel>
                            <TextBlock x:Name="BasicAttackHint" Text="{DynamicResource Editor.BasicAttackHint}" Foreground="#888" TextWrapping="Wrap"
                                       Margin="70,0,0,6" Visibility="Collapsed" />
                            <CheckBox x:Name="StepWithPrevious" Margin="70,0,0,6" Click="StepField_Changed"
                                      Content="{DynamicResource Editor.WithPrevious}" />
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Editor.Label}" Style="{StaticResource Label}" Width="70" />
                                <TextBox DockPanel.Dock="Left" x:Name="StepLabel" Width="140" VerticalAlignment="Center" TextChanged="StepField_Changed" />
                                <TextBlock Text="{DynamicResource Editor.LabelHint}" Foreground="#888" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Editor.Note}" Style="{StaticResource Label}" Width="70" />
                                <TextBox DockPanel.Dock="Left" x:Name="StepNote" Width="140" VerticalAlignment="Center" TextChanged="StepField_Changed" />
                                <TextBlock Text="{DynamicResource Editor.NoteHint}" Foreground="#888" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <!-- A step's expected state: kept in files, but hidden, since nothing uses it while the
                                 strip marks no current step (the phase shown comes from the phases' conditions). -->
                            <StackPanel x:Name="ExpectSection" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Editor.Expect}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Text="{DynamicResource Editor.ExpectHint}" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <StackPanel x:Name="ConditionRows" />
                                <Button Content="{DynamicResource Editor.AddCondition}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddCondition_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Preview -->
        <GroupBox Grid.Row="3" Header="{DynamicResource Editor.Preview}">
            <Border Background="#5A646E" Padding="8" CornerRadius="4">
                <!-- Shrinks to fit: the strip is drawn at its in-game size. -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="150">
                    <ContentControl x:Name="PreviewHost" />
                </Viewbox>
            </Border>
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock x:Name="ProblemsText" Foreground="#B04030" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Foreground="#2E7D32" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button Content="{DynamicResource Editor.ImportFile}" Click="ImportFile_Click" />
            <Button Content="{DynamicResource Editor.PasteCode}" Click="PasteCode_Click" />
            <Button Content="{DynamicResource Editor.ExportFile}" Click="ExportFile_Click" />
            <Button Content="{DynamicResource Editor.CopyCode}" Click="CopyCode_Click" />
            <Button x:Name="RestorePublishedButton" Content="{DynamicResource Editor.RestorePublished}" Click="RestorePublished_Click"
                    ToolTip="{DynamicResource Editor.RestorePublished.Hint}" Margin="18,0,6,0" />
            <Button DockPanel.Dock="Right" Content="{DynamicResource Editor.Close}" Click="CloseButton_Click" Margin="0" />
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="{DynamicResource Editor.Save}" Click="SaveButton_Click" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
