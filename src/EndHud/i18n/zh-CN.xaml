<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 简体中文。{0}、{1} 等为运行时填入的值，翻译时请保留。 -->

    <!-- HUD 面板 -->
    <sys:String x:Key="Hud.Title">ENDHUD</sys:String>
    <sys:String x:Key="Hud.Status.Tracking">跟踪中：{0}</sys:String>
    <sys:String x:Key="Hud.Status.NotFound">未检测到游戏（演示模式）</sys:String>
    <sys:String x:Key="Hud.Status.TargetNotFound">未找到窗口“{0}”（演示模式）</sys:String>
    <sys:String x:Key="Hud.Size">窗口 {0} × {1}，位置 ({2}, {3})</sys:String>
    <sys:String x:Key="Hud.Hint">Ctrl+Shift+M 菜单　　Ctrl+Shift+H 显示/隐藏　　Ctrl+Shift+D 调试面板　　Ctrl+Shift+Q 退出</sys:String>

    <!-- 连携就绪提示 -->
    <sys:String x:Key="ComboHint.Ready">连携就绪</sys:String>
    <sys:String x:Key="ComboHint.Sample">连携提示</sys:String>
    <sys:String x:Key="ComboHint.Drag">按住拖动，调整提示位置</sys:String>

    <!-- 小队识别 -->
    <sys:String x:Key="Party.Header">小队</sys:String>
    <sys:String x:Key="Party.Slot">{0}　等级 {1}　生命 {2}</sys:String>
    <sys:String x:Key="Party.Skills">　　连携 {0}　终结技 {1}</sys:String>
    <sys:String x:Key="Party.Combo.Ready">就绪</sys:String>
    <sys:String x:Key="Party.Combo.Cooling">冷却中 {0}</sys:String>
    <sys:String x:Key="Party.Ultimate.Ready">就绪</sys:String>
    <sys:String x:Key="Party.Ultimate.Charging">充能 {0}</sys:String>
    <sys:String x:Key="Party.SlotNumber">{0} 号位</sys:String>
    <sys:String x:Key="Party.Dead">{0}　阵亡</sys:String>
    <sys:String x:Key="Party.Unknown">—</sys:String>
    <sys:String x:Key="Party.Waiting">正在识别小队栏……</sys:String>
    <sys:String x:Key="Party.NotVisible">画面中暂未看到小队栏（可能正在打开菜单或地图）</sys:String>
    <sys:String x:Key="Party.CaptureFailed">无法捕获游戏画面，稍后会自动重试</sys:String>
    <sys:String x:Key="Party.OcrUnavailable">系统未安装文字识别语言包。请在“设置 → 时间和语言 → 语言和区域”中添加英语或中文。</sys:String>

    <!-- 菜单 -->
    <sys:String x:Key="Menu.Title">ENDHUD — 菜单</sys:String>
    <sys:String x:Key="Menu.Hotkeys">快捷键</sys:String>
    <sys:String x:Key="Menu.Key.Menu">打开/关闭此菜单</sys:String>
    <sys:String x:Key="Menu.Key.Toggle">显示/隐藏 HUD</sys:String>
    <sys:String x:Key="Menu.Key.Quit">退出 EndHud</sys:String>
    <sys:String x:Key="Menu.Key.Debug">显示/隐藏调试面板</sys:String>
    <sys:String x:Key="Menu.Key.Esc">关闭此菜单</sys:String>
    <sys:String x:Key="Menu.Settings">设置（自动保存）</sys:String>
    <sys:String x:Key="Menu.AutoShow">游戏窗口获得焦点时自动显示 HUD</sys:String>
    <sys:String x:Key="Menu.AutoShow.Hint">关闭后，需按 Ctrl+Shift+H 或在托盘菜单中手动显示。</sys:String>
    <sys:String x:Key="Menu.PartyOcr">识别小队栏（连携就绪提示需要此项）</sys:String>
    <sys:String x:Key="Menu.DebugPanel">显示调试面板（识别到的等级、生命值和技能）</sys:String>
    <sys:String x:Key="Menu.ComboHint">连携就绪提示</sys:String>
    <sys:String x:Key="Menu.ComboHint.Hint">战斗中干员的连携技冷却结束时，在屏幕上提示。菜单打开时，可直接拖动屏幕上的提示框调整位置。</sys:String>
    <sys:String x:Key="Menu.ComboHint.Enabled">显示连携就绪提示</sys:String>
    <sys:String x:Key="Menu.ComboHint.WhenReady">冷却结束时提示</sys:String>
    <sys:String x:Key="Menu.ComboHint.WhileReady">冷却结束后一直显示，直到再次使用</sys:String>
    <sys:String x:Key="Menu.ComboHint.Seconds">{0} 秒</sys:String>
    <sys:String x:Key="Menu.ComboHint.ResetPosition">恢复默认位置</sys:String>
    <sys:String x:Key="Menu.Operators">干员识别</sys:String>
    <sys:String x:Key="Menu.Operators.Hint">头像来自 Endfield Wiki，首次识别可能不准。请为每个位置选择正确的干员，EndHud 会记住该干员在游戏中的样子，之后就能准确识别。</sys:String>
    <sys:String x:Key="Menu.Operators.Unrecognised">未识别（显示为“{0} 号位”）</sys:String>
    <sys:String x:Key="Menu.Operators.NoReading">切换到游戏画面、并能看到左下角的小队栏后，这里会列出识别结果。</sys:String>
    <sys:String x:Key="Menu.Operators.NoLibrary">正在从 Endfield Wiki 下载干员头像库，请稍候（首次运行需要联网）。</sys:String>
    <sys:String x:Key="Menu.Operators.Saved">已记住：{0} 号位是 {1}</sys:String>
    <sys:String x:Key="Menu.Operators.Cleared">已将 {0} 号位设为未识别</sys:String>
    <sys:String x:Key="Menu.Operators.Forget">清除所有已学习的头像</sys:String>
    <sys:String x:Key="Menu.Operators.ForgetConfirm">再次点击以确认清除</sys:String>
    <sys:String x:Key="Menu.Operators.Forgotten">已清除所有已学习的头像</sys:String>
    <sys:String x:Key="Menu.Close">关闭</sys:String>

    <!-- 干员头像库 -->
    <sys:String x:Key="Operators.Downloading">正在从 Endfield Wiki 下载干员头像和技能图标……</sys:String>
    <sys:String x:Key="Operators.Updated">干员头像库已更新，共 {0} 名干员</sys:String>
    <sys:String x:Key="Operators.FirstDownloadFailed">无法下载干员头像库（请检查网络）。EndHud 会自动重试，也可在托盘菜单中选择“更新干员头像库”。在此之前，干员显示为“n 号位”。</sys:String>
    <sys:String x:Key="Operators.UpdateFailed">更新干员头像库失败（请检查网络），继续使用已下载的头像库。可稍后在托盘菜单中重试。</sys:String>

    <!-- 系统托盘 -->
    <sys:String x:Key="Tray.Tooltip">EndHud 游戏辅助面板</sys:String>
    <sys:String x:Key="Tray.Status.Found">状态：已检测到游戏</sys:String>
    <sys:String x:Key="Tray.Status.NotFound">状态：未检测到游戏</sys:String>
    <sys:String x:Key="Tray.ShowHud">显示 HUD（Ctrl+Shift+H）</sys:String>
    <sys:String x:Key="Tray.OpenMenu">打开菜单（Ctrl+Shift+M）</sys:String>
    <sys:String x:Key="Tray.AutoShow">游戏获得焦点时自动显示</sys:String>
    <sys:String x:Key="Tray.DebugPanel">显示调试面板（Ctrl+Shift+D）</sys:String>
    <sys:String x:Key="Tray.UpdateOperators">更新干员头像库</sys:String>
    <sys:String x:Key="Tray.OpenConfig">打开配置文件所在文件夹</sys:String>
    <sys:String x:Key="Tray.Quit">退出</sys:String>
    <sys:String x:Key="Tray.Started">EndHud 已在系统托盘中运行。切换到游戏后会自动显示，按 Ctrl+Shift+M 打开菜单，右键托盘图标可更改设置。</sys:String>
    <sys:String x:Key="Tray.Started.Manual">EndHud 已在系统托盘中运行。按 Ctrl+Shift+H 显示 HUD，右键托盘图标可更改设置。</sys:String>

</ResourceDictionary>
