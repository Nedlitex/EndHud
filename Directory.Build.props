<Project>
  <PropertyGroup>
    <!--
      The Windows projection (C#/WinRT) every project builds against, pinned instead of taken from whichever
      .NET SDK builds it. SDK 8.0.100 brings 10.0.22621.31 (C#/WinRT 2.0.4), whose awaited operations can
      answer null, throw, or crash the process when the garbage collector runs while a result is taken
      (optimized code only): see WindowsAwaitTests. 10.0.22621.57 (C#/WinRT 2.2) does not. Pinned, a local
      build and the CI/release build (which takes the newest 8.0.x SDK) ship the same projection.
    -->
    <WindowsSdkPackageVersion>10.0.22621.57</WindowsSdkPackageVersion>
    <!--
      Every NuGet package is pinned with its content hash in each project's packages.lock.json. On GitHub Actions
      (CI=true) a restore that would differ from the lock file fails instead of taking whatever the feed serves.
      After changing a package: dotnet restore (locally), and commit the updated lock files.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
