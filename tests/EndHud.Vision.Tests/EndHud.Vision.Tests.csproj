<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The capture test shows a stand-in game window. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EndHud.Vision\EndHud.Vision.csproj" />
  </ItemGroup>

  <!-- Screenshots and gameplay recordings come from the test data submodule (tests/data, the
       EndHud-test-data repository), copied next to the binaries as Fixtures\ and Recordings\.
       Building doesn't need them; running the tests does. -->
  <PropertyGroup>
    <TestData>$(MSBuildThisFileDirectory)..\data\</TestData>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(TestData)Fixtures\**" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TestData)Recordings\**" LinkBase="Recordings" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingTestData" BeforeTargets="Build" Condition="!Exists('$(TestData)Fixtures')">
    <Warning Text="The test data isn't here (tests/data is empty): the vision tests need it. Fetch it with: git submodule update --init" />
  </Target>
  <Target Name="RequireTestData" BeforeTargets="VSTest" Condition="!Exists('$(TestData)Fixtures')">
    <Error Text="The test data isn't here (tests/data is empty). Fetch it with: git submodule update --init (about 220 MB; see tests/data in DEVELOPER.md)" />
  </Target>

</Project>
