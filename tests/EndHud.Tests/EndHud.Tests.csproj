<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Tests the tray app (WPF), and shows a stand-in game window (WinForms). -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EndHud\EndHud.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The readings of the owner's 2026-10-20 inn recording (text: what the readers read on each frame, no picture),
         replayed through the session and the overlays' views (InnReplayTests). -->
    <None Include="Fixtures\inn-replay\*.jsonl.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- A 4K gameplay frame for the windowed-capture tests (Category=Desktop), from the test data
         submodule (tests/data); without it only those tests can't run. -->
    <None Include="..\data\Fixtures\combat-combos-nearly-refilled.jpg" Link="Fixtures\combat-combos-nearly-refilled.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\combat-combos-nearly-refilled.jpg')" />
    <!-- Inn frames for the inn wire-up's tests: the real readers end to end. -->
    <None Include="..\data\Fixtures\inn\session-gourmand-order.jpg" Link="Fixtures\inn\session-gourmand-order.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\session-gourmand-order.jpg')" />
    <None Include="..\data\Fixtures\inn\dispatch-panel-queue.jpg" Link="Fixtures\inn\dispatch-panel-queue.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\dispatch-panel-queue.jpg')" />
    <None Include="..\data\Fixtures\inn\setup-gourmand-theme.jpg" Link="Fixtures\inn\setup-gourmand-theme.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\setup-gourmand-theme.jpg')" />
    <None Include="..\data\Fixtures\inn\menu-gourmand-theme.jpg" Link="Fixtures\inn\menu-gourmand-theme.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\menu-gourmand-theme.jpg')" />
    <None Include="..\data\Fixtures\inn\setup-chefs-placed.jpg" Link="Fixtures\inn\setup-chefs-placed.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\setup-chefs-placed.jpg')" />
    <None Include="..\data\Fixtures\inn\chef-picker.jpg" Link="Fixtures\inn\chef-picker.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\chef-picker.jpg')" />
    <None Include="..\data\Fixtures\inn\setup-soup-entree-empty.jpg" Link="Fixtures\inn\setup-soup-entree-empty.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\setup-soup-entree-empty.jpg')" />
    <None Include="..\data\Fixtures\inn\chef-picker-kitchen1-empty.jpg" Link="Fixtures\inn\chef-picker-kitchen1-empty.jpg"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\Fixtures\inn\chef-picker-kitchen1-empty.jpg')" />
    <None Include="..\data\Fixtures\inn\menu-dishes.jpg" Link="Fixtures\inn\menu-dishes.jpg"
