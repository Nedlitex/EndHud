# Normalise text to LF in the repository; check out with the platform's line endings.
* text=auto
# Files Visual Studio / dotnet tooling write with CRLF; keep them that way everywhere.
*.sln     text eol=crlf
*.csproj  text eol=crlf
# Binary assets: never diff or convert.
*.png     binary
*.ico     binary
*.gif     binary
*.jpg     binary
*.mp4     binary
*.onnx    binary
tests/EndHud.Vision.Tests/Recordings/*.mp4 filter=lfs diff=lfs merge=lfs -text
src/EndHud.Vision/Assets/ccip/*.onnx filter=lfs diff=lfs merge=lfs -text
src/EndHud.Vision/Assets/operator-portraits.json -diff
